{
  "name": "devkit",
  "version": "1.0.0",
  "private": true,
  "description": "Private, offline-capable developer tools that run entirely in the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/generate-og.ts",
    "build": "next build && node scripts/generate-sw.mjs",
    "start": "serve out -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "og": "tsx scripts/generate-og.ts"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "serve": "^14.2.5",
    "sharp": "^0.34.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
