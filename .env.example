# Absolute origin used for canonical URLs, Open Graph, sitemap, and robots.
# GitHub Pages project site example:
# NEXT_PUBLIC_SITE_URL=https://YOUR_USER.github.io/devkit
# NEXT_PUBLIC_BASE_PATH=/devkit
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=

# Reserved ad slot. Off unless both the flag and a Carbon serve id are set.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_CARBON_SERVE=
NEXT_PUBLIC_CARBON_PLACEMENT=

# Privacy-friendly analytics. Off unless the flag and a domain are set.
NEXT_PUBLIC_PLAUSIBLE=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Optional sponsor button on the Support page. Leave empty to hide the button.
NEXT_PUBLIC_SPONSOR_URL=
